#!/bin/sh
# webosbrew boot hook (rooted LG TVs): Free My TV as the home screen, see launcher.js next to it.
# No dot in this file's name: BusyBox run-parts skips those. Never blocks boot: the watcher runs in the background.
DIR=/var/lib/freemytv
PID=/tmp/freemytv-launcher.pid
# One watcher: a running one stops first (by its pid, not pkill -f, which also matches any shell naming the file).
[ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null && rm -f "$PID"
[ -f "$DIR/off" ] && exit 0
[ -f "$DIR/launcher.js" ] || exit 0
[ -x /usr/bin/node ] || exit 0
nohup /usr/bin/node "$DIR/launcher.js" io.freemytv </dev/null >/dev/null 2>&1 &
echo $! > "$PID"
exit 0
